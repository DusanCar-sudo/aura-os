// Aura OS — one waybar process, two bars (RAM budget, task 003).
//   top:  herdr tabs (1-9 + "+"), window title, clock
//   left: spaces + agents — the herdr sidebar
// Updates are event-driven: aura-os-status watch pokes RTMIN+8 and the
// label execs re-run. No interval anywhere — nothing polls.
[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "on-sigusr1": "noop",
    "modules-left": [
      "custom/sidebar",
      "custom/tab1", "custom/tab2", "custom/tab3", "custom/tab4",
      "custom/tab5", "custom/tab6", "custom/tab7", "custom/tab8",
      "custom/tab9", "custom/tabplus"
    ],
    "modules-center": ["sway/window"],
    "modules-right": ["bluetooth", "network", "wireplumber", "custom/clip", "clock"],
    "custom/tab1": {
      "exec": "aura-os-tab label 1",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 1",
      "on-click-middle": "aura-os-tab rename 1",
      "on-click-right": "aura-os-tab color-pick 1"
    },
    "custom/tab2": {
      "exec": "aura-os-tab label 2",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 2",
      "on-click-middle": "aura-os-tab rename 2",
      "on-click-right": "aura-os-tab color-pick 2"
    },
    "custom/tab3": {
      "exec": "aura-os-tab label 3",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 3",
      "on-click-middle": "aura-os-tab rename 3",
      "on-click-right": "aura-os-tab color-pick 3"
    },
    "custom/tab4": {
      "exec": "aura-os-tab label 4",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 4",
      "on-click-middle": "aura-os-tab rename 4",
      "on-click-right": "aura-os-tab color-pick 4"
    },
    "custom/tab5": {
      "exec": "aura-os-tab label 5",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 5",
      "on-click-middle": "aura-os-tab rename 5",
      "on-click-right": "aura-os-tab color-pick 5"
    },
    "custom/tab6": {
      "exec": "aura-os-tab label 6",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 6",
      "on-click-middle": "aura-os-tab rename 6",
      "on-click-right": "aura-os-tab color-pick 6"
    },
    "custom/tab7": {
      "exec": "aura-os-tab label 7",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 7",
      "on-click-middle": "aura-os-tab rename 7",
      "on-click-right": "aura-os-tab color-pick 7"
    },
    "custom/tab8": {
      "exec": "aura-os-tab label 8",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 8",
      "on-click-middle": "aura-os-tab rename 8",
      "on-click-right": "aura-os-tab color-pick 8"
    },
    "custom/tab9": {
      "exec": "aura-os-tab label 9",
      "return-type": "json",
      "signal": 8,
      "tooltip": false,
      "on-click": "swaymsg workspace number 9",
      "on-click-middle": "aura-os-tab rename 9",
      "on-click-right": "aura-os-tab color-pick 9"
    },
    "custom/sidebar": {
      "format": "\u2261",
      "tooltip-format": "hide/show sidebar (Super+B)",
      "on-click": "aura-os-tab sidebar toggle"
    },
    "custom/tabplus": {
      "format": "+",
      "tooltip": false,
      "on-click": "aura-os-tab new"
    },
    "sway/window": { "max-length": 60 },
    // Classic system items, plain text (herdr look). Click → a floating
    // TUI in aura-term (app_id aura-float, see sway config).
    "bluetooth": {
      "format": "bt {status}",
      "format-connected": "bt {device_alias}",
      "format-off": "bt off",
      "format-disabled": "bt off",
      "format-no-controller": "",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias} {device_address}",
      "on-click": "aura-os-settings bluetooth"
    },
    "network": {
      "format-wifi": "wifi {essid} {signalStrength}%",
      "format-ethernet": "eth {ifname}",
      "format-disconnected": "net off",
      "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
      "on-click": "aura-os-settings wifi"
    },
    "wireplumber": {
      "format": "vol {volume}%",
      "format-muted": "vol mute",
      "scroll-step": 5,
      "on-click": "aura-os-settings sound",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/clip": {
      "exec": "aura-os-clip label",
      "return-type": "json",
      "signal": 9,
      "on-click": "aura-os-clip pick",
      "on-click-right": "aura-os-clip clear"
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "weeks-pos": "left",
        "on-scroll": 1,
        "format": {
          "today": "<span color='#8b7cf6'><b>{}</b></span>",
          "weeks": "<span color='#5c5f77'>{}</span>"
        }
      },
      "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" },
      "on-click": "aura-term --app-id=aura-float -e sh -c 'cal -3 --monday; read -rsn1'"
    }
  },
  {
    "name": "left",
    "layer": "top",
    "position": "left",
    "width": 300,
    "spacing": 0,
    "on-sigusr1": "toggle",
    "modules-left": ["custom/spaces", "memory"],
    "modules-right": ["custom/agents"],
    // The one system reading in the sidebar. The only polled module:
    // RAM has no change event; one /proc/meminfo read every 5 s.
    "memory": {
      "interval": 5,
      "align": 0,
      "format": "ram {used:0.1f}/{total:0.1f}G {percentage}%",
      "tooltip-format": "swap {swapUsed:0.1f}/{swapTotal:0.1f}G",
      "states": { "high": 85 }
    },
    "custom/spaces": {
      "align": 0,
      "justify": "left",
      "exec": "aura-os-status spaces",
      "return-type": "json",
      "escape": false,
      "signal": 8,
      "tooltip": false
    },
    "custom/agents": {
      "align": 0,
      "justify": "left",
      "exec": "aura-os-status agents",
      "return-type": "json",
      "escape": false,
      "signal": 8,
      "tooltip": false,
      "on-click": "aura-os-status focus-agent"
    }
  }
]
