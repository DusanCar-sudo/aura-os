#!/usr/bin/env bash
# aura-os-theme — color combos for the whole desktop in one step.
#
#   aura-os-theme list            themes available (* = current)
#   aura-os-theme apply <name>    recolor sway, waybar, aura-term, fuzzel,
#                                 KDE/Qt apps (dolphin), GTK apps, and the
#                                 sidebar labels — whole system follows
#   aura-os-theme pick            choose with fuzzel
#   aura-os-theme current
#
# A theme is themes/<name>/palette (15 key=value colors). apply writes
# small generated files next to each app's config — the repo's config
# files stay untouched:
#   ~/.config/sway/config.d/50-theme.conf   ~/.config/waybar/theme.css
#   ~/.config/aura-term/theme.ini           ~/.config/fuzzel/theme.ini
#   ~/.config/aura-os/colors.sed   (sidebar scripts: purplerain hex → theme)
#   ~/.local/share/aura-os/icons/*.svg  (fg color; aura.svg in accent)
#   ~/.local/share/icons/Aura  (launcher icon theme, from assets/icons/icon-map)
# Tab colors (Super+Shift+C) are fixed names and don't change with themes.
set -euo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
state="$cfg/aura-os/theme"
dirs=("$cfg/aura-os/themes" /usr/share/aura-os/themes "${AURA_OS_REPO:-$HOME/aura-os}/themes")
icon_src=(/usr/share/aura-os/icons "${AURA_OS_REPO:-$HOME/aura-os}/assets/icons")
icon_out="${XDG_DATA_HOME:-$HOME/.local/share}/aura-os/icons"

theme_dir() { local d; for d in "${dirs[@]}"; do [[ -f $d/$1/palette ]] && { echo "$d/$1"; return; }; done; return 1; }
names() { local d; for d in "${dirs[@]}"; do [[ -d $d ]] && ls "$d"; done | sort -u; }
current() { cat "$state" 2>/dev/null || echo purplerain; }

load() {   # load <name> → exports c_<key> for all 15 colors
    local dir line k v
    dir="$(theme_dir "$1")" || { echo "aura-os-theme: no theme '$1'" >&2; exit 2; }
    while IFS= read -r line; do
        [[ $line =~ ^([a-z_]+)=(#[0-9a-fA-F]{6})$ ]] || continue
        k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
        printf -v "c_$k" '%s' "$v"
    done < "$dir/palette"
    : "${c_bg:?} ${c_fg:?} ${c_accent:?}"
}

put() { mkdir -p "$(dirname "$1")"; cat > "$1.tmp" && mv "$1.tmp" "$1"; }
nohash() { printf '%s' "${1#\#}"; }

apply() {
    load "$1"
    put "$cfg/sway/config.d/50-theme.conf" <<EOF
# generated by aura-os-theme ($1) — edit themes/$1/palette instead
client.focused          $c_accent $c_bg $c_fg $c_accent $c_accent
client.focused_inactive $c_bg $c_bg $c_dim $c_bg $c_bg
client.unfocused        $c_bg $c_bg $c_dim $c_bg $c_bg
client.background       $c_bg
output * bg $c_bg solid_color
EOF
    put "$cfg/waybar/theme.css" <<EOF
/* generated by aura-os-theme ($1) */
@define-color bg $c_bg;
@define-color bg_alt $c_bg_alt;
@define-color border $c_border;
@define-color fg $c_fg;
@define-color fg_bright $c_fg_bright;
@define-color dim $c_dim;
@define-color muted $c_muted;
@define-color accent $c_accent;
@define-color accent_bright $c_accent_bright;
@define-color red $c_red;
@define-color green $c_green;
@define-color yellow $c_yellow;
@define-color blue $c_blue;
@define-color cyan $c_cyan;
@define-color orange $c_orange;
EOF
    put "$cfg/aura-term/theme.ini" <<EOF
# generated by aura-os-theme ($1)
[colors-dark]
background=$(nohash "$c_bg")
foreground=$(nohash "$c_fg")
selection-background=$(nohash "$c_border")
selection-foreground=$(nohash "$c_fg_bright")
regular0=$(nohash "$c_bg_alt")
regular1=$(nohash "$c_red")
regular2=$(nohash "$c_green")
regular3=$(nohash "$c_yellow")
regular4=$(nohash "$c_blue")
regular5=$(nohash "$c_accent")
regular6=$(nohash "$c_cyan")
regular7=$(nohash "$c_fg")
bright0=$(nohash "$c_dim")
bright1=$(nohash "$c_red")
bright2=$(nohash "$c_green")
bright3=$(nohash "$c_yellow")
bright4=$(nohash "$c_blue")
bright5=$(nohash "$c_accent_bright")
bright6=$(nohash "$c_cyan")
bright7=$(nohash "$c_fg_bright")
EOF
    put "$cfg/fuzzel/theme.ini" <<EOF
# generated by aura-os-theme ($1)
[colors]
background=$(nohash "$c_bg")f2
text=$(nohash "$c_fg")ff
prompt=$(nohash "$c_dim")ff
input=$(nohash "$c_fg_bright")ff
placeholder=$(nohash "$c_dim")ff
match=$(nohash "$c_accent")ff
selection=$(nohash "$c_border")ff
selection-text=$(nohash "$c_fg_bright")ff
selection-match=$(nohash "$c_accent_bright")ff
counter=$(nohash "$c_dim")ff
border=$(nohash "$c_accent")ff
EOF
    # One theme for the whole system: aura-os-shell's menus (and the Rust
    # tools) read ~/.config/aura/theme + themes/<name>.conf, so the same
    # palette is written there. That directory is the user override, so it
    # wins over any shipped shell theme with the same name.
    put "$cfg/aura/themes/$1.conf" <<EOF
# generated by aura-os-theme - the menus' view of themes/$1/palette
NAME="$1"
BG="$c_bg"
SURFACE="$c_bg_alt"
LINE="$c_border"
FG="$c_fg"
DIM="$c_dim"
ACCENT="$c_accent"
ACCENT2="$c_accent_bright"
FONT="JetBrainsMono Nerd Font, monospace"
RADIUS="0px"
EOF
    printf '%s\n' "$1" | put "$cfg/aura/theme"

    # sidebar scripts write purplerain hex in their Pango markup; map it.
    put "$cfg/aura-os/colors.sed" <<EOF
s/#0e0e14/$c_bg/Ig
s/#14141e/$c_bg_alt/Ig
s/#2a2a3a/$c_border/Ig
s/#c8cad8/$c_fg/Ig
s/#e6e8f2/$c_fg_bright/Ig
s/#5c5f77/$c_dim/Ig
s/#7f849c/$c_muted/Ig
s/#8b7cf6/$c_accent/Ig
s/#a594f9/$c_accent_bright/Ig
s/#f38ba8/$c_red/Ig
s/#83e6a0/$c_green/Ig
s/#f9e2af/$c_yellow/Ig
EOF
    # KDE/Qt apps (dolphin, konsole): BreezeDark as the base scheme,
    # recolored to the palette. Missing keys keep BreezeDark's sane
    # defaults, so a partial palette still yields a complete scheme.
    if [[ -r /usr/share/color-schemes/BreezeDark.colors ]]; then
        dir="${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes"
        mkdir -p "$dir"
        rgb() { local h="${1#\#}"; echo "$((16#${h:0:2})),$((16#${h:2:2})),$((16#${h:4:2}))"; }
        awk -v bg="$(rgb "$c_bg")" -v bgalt="$(rgb "$c_bg_alt")" \
            -v fg="$(rgb "$c_fg")" -v fgb="$(rgb "$c_fg_bright")" \
            -v dim="$(rgb "$c_dim")" -v acc="$(rgb "$c_accent")" \
            -v accb="$(rgb "$c_accent_bright")" '
            /^\[/ { sec=$0 }
            /^BackgroundNormal=/   { $0="BackgroundNormal="   (sec=="[Colors:Selection]" ? acc : bg) }
            /^BackgroundAlternate=/{ $0="BackgroundAlternate=" bgalt }
            /^ForegroundNormal=/   { $0="ForegroundNormal="   (sec=="[Colors:Selection]" ? fgb : fg) }
            /^ForegroundInactive=/ { $0="ForegroundInactive=" dim }
            /^ForegroundActive=/   { $0="ForegroundActive="   acc }
            /^ForegroundLink=/     { $0="ForegroundLink="     accb }
            /^Name=Breeze Dark$/   { $0="Name=Aura" }
            { print }' /usr/share/color-schemes/BreezeDark.colors > "$dir/Aura.colors"
        # point KConfig at it (kdeglobals is INI; kwriteconfig6 edits it
        # in place, manual fallback creates/patches the two keys)
        if command -v kwriteconfig6 >/dev/null; then
            kwriteconfig6 --file kdeglobals --group General --key ColorScheme Aura
            kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle Breeze
        else
            touch "$cfg/kdeglobals"
            grep -q '^\[General\]' "$cfg/kdeglobals" 2>/dev/null || echo '[General]' >> "$cfg/kdeglobals"
            sed -i '/^\[General\]/,/^\[/{s/^ColorScheme=.*/ColorScheme=Aura/;}' "$cfg/kdeglobals"
            grep -q '^ColorScheme=' "$cfg/kdeglobals" || sed -i '/^\[General\]/a ColorScheme=Aura' "$cfg/kdeglobals"
            grep -q '^\[KDE\]' "$cfg/kdeglobals" || echo '[KDE]' >> "$cfg/kdeglobals"
            sed -i '/^\[KDE\]/,/^\[/{s/^widgetStyle=.*/widgetStyle=Breeze/;}' "$cfg/kdeglobals"
            grep -q '^widgetStyle=' "$cfg/kdeglobals" || sed -i '/^\[KDE\]/a widgetStyle=Breeze' "$cfg/kdeglobals"
        fi
    fi

    # GTK apps: Breeze-Dark follows the same visual language; libadwaita
    # (GTK4) reads the portal color-scheme, set it directly when possible.
    for v in gtk-3.0 gtk-4.0; do
        mkdir -p "$cfg/$v"
        if [[ -f $cfg/$v/settings.ini ]]; then
            grep -vE '^gtk-(theme-name|application-prefer-dark-theme|icon-theme-name)=' "$cfg/$v/settings.ini" > "$cfg/$v/settings.ini.tmp"
        else
            : > "$cfg/$v/settings.ini.tmp"
        fi
        cat >> "$cfg/$v/settings.ini.tmp" <<EOF

[Settings]
gtk-theme-name=Breeze-Dark
gtk-application-prefer-dark-theme=1
gtk-icon-theme-name=breeze-dark
EOF
        mv "$cfg/$v/settings.ini.tmp" "$cfg/$v/settings.ini"
    done
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true

    # The theme's own wallpaper, if one is installed and the current
    # wallpaper is another theme's (or none) — a picture the user chose
    # themselves is left alone.
    wall=""
    for d in "$cfg/aura-os/wallpapers" /usr/share/aura-os/wallpapers \
             "${AURA_OS_REPO:-$HOME/aura-os}/assets/wallpapers"; do
        [[ -f $d/$1.png ]] && { wall="$d/$1.png"; break; }
    done
    if [[ -n $wall ]]; then
        cur="$(sed -n 's/^output \* bg "\(.*\)" fill/\1/p' \
              "$cfg/sway/config.d/60-wallpaper.conf" 2>/dev/null | head -n1)"
        if [[ -z $cur || $(basename "$(dirname "$cur")") == wallpapers ]]; then
            put "$cfg/sway/config.d/60-wallpaper.conf" <<EOF
# aura-os-theme ($1) — the theme's wallpaper; pick your own with
# aura-os-wallpaper and this stops following the theme.
output * bg "$wall" fill
EOF
        fi
    fi

    # icons: each SVG draws in currentColor; bake the theme color in (not
    # every renderer honors currentColor — fuzzel's doesn't).
    local src i c
    for src in "${icon_src[@]}"; do [[ -d $src/ ]] && [[ -f $src/icon-map ]] && break; done
    if [[ -d $src ]]; then
        for i in "$src"/*.svg; do
            c=$c_fg; [[ ${i##*/} == aura.svg ]] && c=$c_accent
            sed -E -e "0,/color=\"#[0-9a-fA-F]{6}\"/s//color=\"$c\"/" -e "s/currentColor/$c/g" \
                -e "s/\"white\"/\"$c_bg\"/g" "$i" | put "$icon_out/${i##*/}"
        done
        # The "Aura" icon theme for the launcher: icon-map says which app
        # icon names each SVG answers to; the rest fall back to breeze-dark.
        local ith="${XDG_DATA_HOME:-$HOME/.local/share}/icons/Aura" name names n
        rm -rf "$ith"; mkdir -p "$ith/scalable/apps"
        put "$ith/index.theme" <<EOF
[Icon Theme]
Name=Aura
Comment=Aura OS monochrome icons, generated by aura-os-theme ($1)
Inherits=breeze-dark,hicolor
Directories=scalable/apps

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
EOF
        while read -r name names; do
            [[ -z $name || $name == \#* || ! -f $icon_out/$name.svg ]] && continue
            for n in $names; do cp "$icon_out/$name.svg" "$ith/scalable/apps/$n.svg"; done
        done < "$src/icon-map"
    fi
    printf '%s\n' "$1" | put "$state"

    # live: sway colors + background, waybar CSS, sidebar labels.
    if [[ -n ${SWAYSOCK:-} ]] || ls "${XDG_RUNTIME_DIR:-/tmp}"/sway-ipc.*.sock >/dev/null 2>&1; then
        export SWAYSOCK="${SWAYSOCK:-$(ls "${XDG_RUNTIME_DIR:-/tmp}"/sway-ipc.*.sock | head -n1)}"
        swaymsg reload >/dev/null 2>&1 || true
    fi
    # own panel/border colours (aura-look) give way to the new theme
    for look in "$HOME/.local/bin/aura-look" aura-look; do
        command -v "$look" >/dev/null && { "$look" theme-changed || true; break; }
    done
    pkill -USR2 -x waybar 2>/dev/null || true
    aura-os-status poke 2>/dev/null || true
    pkill -RTMIN+10 -x waybar 2>/dev/null || true
    command -v aura-term-theme >/dev/null && aura-term-theme --push-system
    echo "theme: $1"
}

case "${1:-}" in
    list)    cur="$(current)"; names | while read -r n; do [[ $n == "$cur" ]] && echo "* $n" || echo "  $n"; done ;;
    apply)   apply "${2:?usage: aura-os-theme apply <name>}" ;;
    pick)    if [[ -t 0 && -t 1 ]] && command -v aura-term-choose >/dev/null; then
                 n="$(names | aura-term-choose --title 'System theme' --current "$(current)")" || exit 0
             else
                 n="$(names | fuzzel --dmenu --prompt "theme ($(current)) > " --lines 8)" || exit 0
             fi
             [[ -n $n ]] && apply "$n" ;;
    current) current ;;
    *)       sed -n '3,8p' "$0" >&2; exit 2 ;;
esac
