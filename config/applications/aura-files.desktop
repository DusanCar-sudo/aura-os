[Desktop Entry]
Type=Application
Name=Files
GenericName=File manager
Comment=File manager with clickable icons — list view, sorting, copy and paste
Exec=aura-term --app-id=aura-files -e $HOME/.local/bin/aura-files %f
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
