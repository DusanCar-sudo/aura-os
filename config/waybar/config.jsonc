  {
    "name": "left",
    "layer": "top",
    "position": "left",
    "width": 270,
    "spacing": 0,
    "on-sigusr1": "toggle",
    "modules-left": ["custom/spaces", "custom/sysgraph", "custom/procs", "custom/minimized"],
    "modules-center": ["custom/recent"],
    "modules-right": ["custom/agents", "custom/llm"],
    // The system block: cpu, ram, gpu, temperatures, power (aura-os-sysgraph).
    // Under the graphs: the running processes, pick one to end it.
    "custom/procs": {
      "format": "\u25b8 processes  (end one)",
      "align": 0,
      "justify": "left",
      "tooltip": false,
      "on-click": "$HOME/.local/bin/aura-os-procs",
      "on-click-right": "$HOME/.local/bin/aura-os-procs cpu"
    },
    // Minimized windows (Super+Z), under the system block; click brings one back.
    "custom/minimized": {
      "exec": "$HOME/.local/bin/aura-os-minimize label",
      "return-type": "json",
      "escape": false,
      "signal": 11,
      "interval": 10,
      "align": 0,
      "justify": "left",
      "on-click": "$HOME/.local/bin/aura-os-minimize restore"
    },
    "custom/sysgraph": {
      "exec": "$HOME/.local/bin/aura-os-sysgraph",
      "return-type": "json",
      "interval": 3,
      "escape": false,
      "align": 0,
      "justify": "left",
      "on-click": "$HOME/.local/bin/aura-sysmon",
      "on-click-right": "$HOME/.local/bin/aura-os-popup btop"
    },
    // Last used anything: $ command, d folder, f file, @ address, a app.
    "custom/recent": {
      "exec": "$HOME/.local/bin/aura-os-recent label",
      "return-type": "json",
      "escape": false,
      "signal": 10,
      "align": 0,
      "justify": "left",
      "on-click": "aura-os-recent pick"
    },
    "custom/spaces": {
      "align": 0,
      "justify": "left",
      "exec": "$HOME/.local/bin/aura-os-status spaces",
      "return-type": "json",
      "escape": false,
      "signal": 8,
      "tooltip": false
    },
    // The local model, under the agent list. Reads a cache — measuring
    // costs tokens, so only a click does that. Right-click picks the model.
    "custom/llm": {
      "exec": "$HOME/.local/bin/aura-os-llmtest status",
      "return-type": "json",
      "interval": 30,
      "escape": false,
      "align": 0,
      "justify": "left",
      "on-click": "$HOME/.local/bin/aura-os-popup bash -c '$HOME/.local/bin/aura-os-llmtest; printf \"\\n[any key]\"; read -rsn1'",
      "on-click-right": "$HOME/.local/bin/aura-os-llmtest pick"
    },

    "custom/agents": {
      "align": 0,
      "justify": "left",
      "exec": "$HOME/.local/bin/aura-os-status agents",
      "return-type": "json",
      "escape": false,
      "signal": 8,
      "tooltip": false,
      "on-click": "aura-os-status focus-agent"
    }
  }
]
