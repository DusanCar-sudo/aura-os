#!/usr/bin/env bash
# aura-os-status — the left sidebar's data and the sway event watcher
# (task 003).
#
#   aura-os-status watch         follow sway's event stream: refresh the
#                                bars, keep sway tab names in sync
#   aura-os-status poke          refresh the bars now
#   aura-os-status spaces        waybar JSON: workspace → folder, branch
#   aura-os-status agents        waybar JSON: claude / codex / aura rows
#   aura-os-status focus-agent   focus the pane the first agent runs in
#
# Shell + jq only, no python (RAM/speed budget, AURA.md). Updates are
# event-driven: the watcher blocks on `swaymsg -t subscribe`; nothing
# polls and no module uses an interval.
set -euo pipefail

cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/aura-os"
tabs_file="$cfg_dir/tabs.json"

rt_dir="${XDG_RUNTIME_DIR:-/tmp}/aura-os"
ws_cache="$rt_dir/workspaces.json"
panes_dir="$rt_dir/panes"          # written by aura-term, docs/pane-status.md

# Refresh the workspace cache (one swaymsg per event instead of one per
# tab label), then tell waybar to re-run its labels.
poke() {
    mkdir -p "$rt_dir"
    swaymsg -t get_workspaces > "$ws_cache.tmp" 2>/dev/null && mv "$ws_cache.tmp" "$ws_cache"
    pkill -RTMIN+8 -x waybar 2>/dev/null || true
}

# Keep sway's workspace names in step with tabs.json: switching to a
# renamed tab (Super+2 → "2") picks up its saved name ("2 api").
sync_names() {
    [[ -f $tabs_file ]] || return 0
    local num name want
    num="$(swaymsg -t get_workspaces | jq -r '.[] | select(.focused) | .num' | head -n1)" || return 0
    [[ -n ${num:-} && $num -gt 0 ]] || return 0
    name="$(jq -r --arg n "$num" '.[$n].name // empty' "$tabs_file")"
    [[ -n $name ]] || return 0
    want="$num $name"
    if ! swaymsg -t get_workspaces | jq -e --arg w "$want" 'any(.[]; .focused and .name == $w)' >/dev/null 2>&1; then
        swaymsg rename workspace to "$want" >/dev/null 2>&1 || true
    fi
}

cmd_watch() {
    while IFS= read -r _event; do
        sync_names
        poke
    done < <(swaymsg -t subscribe -m '["workspace", "window"]' 2>/dev/null)
}

cmd_spaces() {
    local text="" num name pid focused cwd branch marker line
    while IFS=$'\t' read -r num name pid focused tag; do
        [[ -n ${num:-} && $num -gt 0 ]] || continue
        cwd=""
        branch=""
        # aura-term windows all share the server's pid; their tag names
        # the pane file that has the real cwd + branch (docs/pane-status.md).
        if [[ ${tag:-} == aura-pane-* && -f $panes_dir/${tag#aura-pane-}.json ]]; then
            IFS=$'\t' read -r cwd branch < <(jq -r '[.cwd // "", .branch // ""] | @tsv' \
                "$panes_dir/${tag#aura-pane-}.json" 2>/dev/null) || true
        elif [[ -n ${pid:-} && $pid != 0 && -d /proc/$pid ]]; then
            cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
            [[ -n $cwd ]] && branch="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        fi
        cwd="${cwd/#"$HOME"/\~}"
        marker="  "
        [[ $focused == true ]] && marker="▸ "
        line="<span color='#8b7cf6'>${marker}$num</span>"
        if [[ -n $name && $name != "$num" ]]; then
            line+=" <span color='#c8cad8'>${name#* }</span>"
        fi
        [[ -n $cwd ]] && line+=" <span color='#5c5f77'>$cwd</span>"
        [[ -n $branch ]] && line+=" <span color='#8b7cf6'>$branch</span>"
        text+="$line"$'\n'
    done < <(swaymsg -t get_tree | jq -r '
        .nodes[].nodes[]
        | select(.type == "workspace" and .num > 0)
        | [ .num, .name,
            (([.. | objects | select(.focused and .pid != null) | .pid] | first) // 0),
            (.focused | tostring),
            (([.. | objects | select(.focused and .pid != null) | .tag // ""] | first) // "") ]
        | @tsv' 2>/dev/null)
    [[ -n $text ]] || text="<span color='#5c5f77'>no workspaces</span>"
    jq -cn --arg text "<span color='#5c5f77'>spaces</span>"$'\n'"$text" '{text:$text}'
}

cmd_agents() {
    # Two sections, newest first, each entry = status line + last step:
    #   agents    from aura-os-agents (claude, codex, aura, hermes logs)
    #   programs  from aura-term pane files (long jobs, agents in panes)
    local agents_dir="$rt_dir/agents" a="" p=""
    if compgen -G "$agents_dir/*.json" >/dev/null; then
        a="$(jq -rs '
            def cut(n): if length > n then .[0:n-1] + "\u2026" else . end;
            def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
            sort_by(-.updated) | .[0:6] | map(
                ({working: "<span color=\"#f9e2af\">\u25cf</span>",
                  done:    "<span color=\"#83e6a0\">\u2713</span>"}[.state] // "\u00b7")
                + " <span color=\"#c8cad8\">" + .agent + "</span> <span color=\"#5c5f77\">"
                + (.where | split("/") | last | cut(18) | esc) + "</span>\n"
                + "  <span color=\"#7f849c\">" + (.step | cut(30) | esc) + "</span>")
            | join("\n")' "$agents_dir"/*.json 2>/dev/null || true)"
    fi
    if compgen -G "$panes_dir/*.json" >/dev/null; then
        p="$(jq -rs '
            def cut(n): if length > n then .[0:n-1] + "\u2026" else . end;
            def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
            map(select(.state != "idle")) | sort_by(-.since) | .[0:6] | map(
                ({input:   "<span color=\"#f38ba8\">!</span>",
                  working: "<span color=\"#f9e2af\">\u25cf</span>",
                  done:    "<span color=\"#83e6a0\">\u2713</span>"}[.state] // "\u00b7")
                + " <span color=\"#c8cad8\">" + ((.cmd // .agent // "job") | cut(22) | esc)
                + "</span> <span color=\"#5c5f77\">" + ((.cwd // "") | split("/") | last | cut(12) | esc) + "</span>"
                + (if (.last // "") != "" then "\n  <span color=\"#7f849c\">" + (.last | cut(30) | esc) + "</span>" else "" end))
            | join("\n")' "$panes_dir"/*.json 2>/dev/null || true)"
    fi
    local text="<span color='#5c5f77'>agents</span>"$'\n'"${a:-<span color='#5c5f77'>none</span>}"
    [[ -n $p ]] && text+=$'\n\n'"<span color='#5c5f77'>programs</span>"$'\n'"$p"
    jq -cn --arg text "$text" '{text:$text}'
}

term_of() {   # term_of <pid> → comm of the terminal it runs in (foot, aura-termd, ...)
    local t; t="$(foot_ancestor "$1" || true)"
    [[ -n $t ]] && cat "/proc/$t/comm" 2>/dev/null || true
}

foot_ancestor() {   # foot_ancestor <pid> → the terminal pid it runs in, if any
    local p="$1" comm ppid
    while [[ $p -gt 1 ]]; do
        comm="$(cat "/proc/$p/comm" 2>/dev/null || true)"
        case $comm in
            foot|footclient|aura-term|aura-termd) printf '%s\n' "$p"; return 0 ;;
        esac
        ppid="$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || true)"
        [[ -n ${ppid:-} && $ppid =~ ^[0-9]+$ && $ppid -ne $p ]] || return 1
        p="$ppid"
    done
    return 1
}

cmd_focus_agent() {
    local name pid foot
    for name in claude codex aura; do
        pid="$(pgrep -x "$name" 2>/dev/null | head -n1 || true)"
        [[ -n $pid ]] || continue
        foot="$(foot_ancestor "$pid" || true)"
        [[ -n $foot ]] || continue
        if swaymsg "[pid=$foot]" focus >/dev/null 2>&1; then
            echo "focused $name (foot pid $foot)"
            return 0
        fi
    done
    echo "aura-os-status: no agent pane found" >&2
    exit 1
}

usage() {
    cat >&2 <<'USAGE'
usage: aura-os-status <command>
  watch         follow sway events: refresh both bars, sync tab names
  poke          refresh the bars now
  spaces        waybar JSON for the sidebar: workspaces, folder, branch
  agents        waybar JSON for the sidebar: claude / codex / aura
  focus-agent   focus the pane the first agent runs in
USAGE
    exit 2
}

case "${1:-}" in
    watch)       cmd_watch ;;
    poke)        poke ;;
    spaces)      cmd_spaces ;;
    agents)      cmd_agents ;;
    focus-agent) cmd_focus_agent ;;
    *)           usage ;;
esac
