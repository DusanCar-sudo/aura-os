#!/usr/bin/env bash
# aura-os-llmtest — is the local model up, and how fast is it right now.
#
#   aura-os-llmtest            run a real prompt and print the numbers
#   aura-os-llmtest status     one waybar JSON line (what the sidebar calls)
#   aura-os-llmtest pick       choose which model the test uses
#
# Two backends, whichever is listening: LM Studio on :1234 and ollama on
# :11434, both OpenAI-compatible at /v1. The sidebar never generates
# anything — it reads the cache this writes, and falls back to a cheap
# liveness check. Only an explicit run costs tokens or CPU.
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/aura-os-menu"

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/aura-os"
cache="${XDG_RUNTIME_DIR:-/tmp}/aura-os-llmtest.json"
mkdir -p "$cfg"

PROMPT="${AURA_LLM_PROMPT:-Name three primary colours.}"
TOKENS="${AURA_LLM_TOKENS:-64}"

backend() {  # -> "<base-url> <name>", or nothing
    local u
    for u in "${AURA_LLM_URL:-}" http://127.0.0.1:1234 http://127.0.0.1:11434; do
        [ -n "$u" ] || continue
        curl -sf -m 1 "$u/v1/models" >/dev/null 2>&1 || continue
        case "$u" in *1234*) echo "$u LM-Studio" ;; *11434*) echo "$u ollama" ;;
                     *)      echo "$u local" ;; esac
        return
    done
}

models() { curl -sf -m 2 "$1/v1/models" | jq -r '.data[].id' 2>/dev/null; }

chosen_model() { # the pinned one if it is still loaded, else the first
    local url="$1" want list
    want="$(cat "$cfg/llm-model" 2>/dev/null)"
    list="$(models "$url")"
    [ -n "$want" ] && grep -qxF "$want" <<<"$list" && { echo "$want"; return; }
    head -1 <<<"$list"
}

run_test() { # run_test <url> <model> -> writes the cache, echoes a summary
    # Streams the answer, like Aura Pulse's bench, so the two numbers that
    # matter come apart: how long until the first token (prompt processing)
    # and how fast tokens arrive after that (generation). Timing the whole
    # request would blend them and understate generation speed.
    local url="$1" model="$2" t0 first="" last="" n=0 line now ttft secs tps
    t0="$(date +%s.%N)"
    while IFS= read -r line; do
        [ "$line" = 'data: [DONE]' ] && break
        case "$line" in data:*) ;; *) continue ;; esac
        # the role-only opening chunk has empty content; it isn't a token
        jq -e '(.choices[0].delta.content // "") != ""' <<<"${line#data: }" >/dev/null 2>&1 || continue
        now="$(date +%s.%N)"
        [ -n "$first" ] || first="$now"
        last="$now"; n=$((n + 1))
    done < <(curl -sfN -m 120 "$url/v1/chat/completions" \
              -H 'Content-Type: application/json' \
              -d "$(jq -n --arg m "$model" --arg p "$PROMPT" --argjson n "$TOKENS" \
                    '{model:$m, max_tokens:$n, stream:true,
                      messages:[{role:"user",content:$p}]}')" 2>/dev/null)
    [ "$n" -gt 0 ] || { echo "no answer"; return 1; }

    # One streamed chunk is one token on LM Studio, ollama and llama.cpp.
    read -r ttft secs tps < <(awk -v a="$t0" -v f="$first" -v l="$last" -v n="$n" 'BEGIN{
        g = l - f; printf "%.2f %.2f %.1f", f - a, l - a, (n > 1 && g > 0 ? (n - 1) / g : 0) }')

    jq -n --arg m "$model" --arg tps "$tps" --arg ttft "$ttft" --arg secs "$secs" \
          --arg ntok "$n" --arg when "$(date +%s)" \
          '{model:$m, tps:$tps, ttft:$ttft, secs:$secs, tokens:$ntok, when:($when|tonumber)}' > "$cache"
    printf '%s\t%s\t%s\t%s\t%s' "$model" "$tps" "$secs" "$n" "$ttft"
}

case "${1:-run}" in
status)
    read -r url name <<<"$(backend)"
    if [ -z "${url:-}" ]; then
        printf '{"text":"llm  offline","tooltip":"no local model server on :1234 or :11434","class":"llm-off"}\n'
        exit 0
    fi
    model="$(chosen_model "$url")"
    if [ -r "$cache" ]; then
        tps="$(jq -r .tps "$cache" 2>/dev/null)"
        when="$(jq -r .when "$cache" 2>/dev/null)"
        age=$(( $(date +%s) - ${when:-0} ))
        if [ "$age" -lt 3600 ]; then
            printf '{"text":"llm  %s  %s tok/s","tooltip":"%s · measured %dm ago · click to re-test","class":"llm-ok"}\n' \
                   "${model:0:18}" "$tps" "$name" "$((age/60))"
            exit 0
        fi
    fi
    printf '{"text":"llm  %s  ready","tooltip":"%s · click to measure tokens/sec","class":"llm-ok"}\n' \
           "${model:0:18}" "$name"
    ;;
pick)
    read -r url _ <<<"$(backend)"
    [ -n "${url:-}" ] || { notify "Local model" "No model server is running"; exit 1; }
    m="$(models "$url" | menu "model")"
    [ -n "${m:-}" ] && { echo "$m" > "$cfg/llm-model"; notify "Local model" "Tests will use $m"; }
    ;;
*)
    read -r url name <<<"$(backend)"
    if [ -z "${url:-}" ]; then
        echo "No local model server answered on :1234 (LM Studio) or :11434 (ollama)."
        echo "Start one, then run this again."
        exit 1
    fi
    model="$(chosen_model "$url")"
    [ -n "$model" ] || { echo "$name is up but has no model loaded."; exit 1; }
    echo "backend   $name  ($url)"
    echo "model     $model"
    echo "prompt    \"$PROMPT\"  (max $TOKENS tokens)"
    echo
    printf 'measuring… '
    if out="$(run_test "$url" "$model")"; then
        IFS=$'\t' read -r _ tps secs ntok ttft <<<"$out"
        printf '\r                \r'
        printf 'speed     %s tokens/sec  (generation)\n' "$tps"
        printf 'waited    %ss for the first token\n' "$ttft"
        printf 'produced  %s tokens in %ss\n' "$ntok" "$secs"
        echo
        echo "Sidebar now shows this until it is an hour old."
    else
        echo "failed — the server answered, but the completion did not."
        exit 1
    fi
    ;;
esac
