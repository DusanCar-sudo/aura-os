#!/usr/bin/env python3
"""aura-os-brightness — backlight slider window + F5/F6 step control.

Aura OS: one small floating window with a single slider, flat and
square to match the purplerain theme. F5/F6 (and the XF86 brightness
keys on laptops that send media codes) are bound in sway to
`aura-os-brightness down|up`; the window stays in sync with those
steps by re-reading the backlight every 400 ms while it is open. A
transient window, not a daemon — it exits when the window closes.

  aura-os-brightness            open the slider window
  aura-os-brightness down       -5%
  aura-os-brightness up         +5%
  aura-os-brightness set <pct>  set 0-100
  aura-os-brightness get        print current % (0-100)
"""
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk

STEP = 5

# purplerain palette (themes/purplerain): bg, accent, dim, text.
CSS = """
window { background-color: #0e0e14; }
scale trough { background-color: #1a1a24; min-height: 6px; min-width: 240px; border-radius: 0; }
scale highlight { background-color: #8b7cf6; border-radius: 0; }
scale slider { background-color: #8b7cf6; border: 1px solid #c8cad8; border-radius: 0;
               min-width: 14px; min-height: 22px; }
label { color: #c8cad8; font-family: "JetBrainsMono Nerd Font", monospace; font-size: 12px; }
"""


def _sh(*args):
    subprocess.run(args, check=False, capture_output=True, text=True)


def get_pct():
    """Current backlight as 0-100 (brightnessctl -m: dev,class,raw,pct%,max)."""
    out = subprocess.run(["brightnessctl", "-m"], capture_output=True, text=True)
    if out.returncode != 0 or not out.stdout.strip():
        return 0
    line = out.stdout.strip().splitlines()[-1]
    fields = line.split(",")
    if len(fields) < 4:
        return 0
    try:
        return int(float(fields[3].rstrip("%")))
    except ValueError:
        return 0


def set_pct(pct):
    pct = max(0, min(100, int(str(pct).rstrip("%"))))
    _sh("brightnessctl", "set", f"{pct}%")


class SliderWindow:
    def __init__(self):
        self.dragging = False
        self.updating = False

    def activate(self, app):
        win = Gtk.Window(application=app)
        win.set_title("brightness")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_default_size(320, 44)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            win.get_screen(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_draw_value(False)
        scale.set_value(get_pct())

        label = Gtk.Label(label=f"{get_pct()}%")

        def on_press(_w, _e):
            self.dragging = True

        def on_release(_w, _e):
            self.dragging = False

        def on_changed(s):
            if self.updating:
                return
            pct = int(s.get_value())
            label.set_text(f"{pct}%")
            set_pct(pct)

        scale.connect("button-press-event", on_press)
        scale.connect("button-release-event", on_release)
        scale.connect("value-changed", on_changed)

        def sync():
            # Follow F5/F6 (brightnessctl) while open; skip mid-drag so
            # the slider never fights the pointer. Poll is bounded to
            # this window's lifetime — not a background daemon.
            if self.dragging:
                return True
            pct = get_pct()
            self.updating = True
            try:
                scale.set_value(pct)
            finally:
                self.updating = False
            label.set_text(f"{pct}%")
            return True

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.pack_start(scale, True, True, 0)
        box.pack_start(label, False, False, 0)
        win.add(box)

        win.show_all()
        GLib.timeout_add(400, sync)

    def run(self):
        app = Gtk.Application(
            application_id="aura-os.brightness",
            flags=Gio.ApplicationFlags.NON_UNIQUE)
        app.connect("activate", self.activate)
        app.run(None)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "window"
    if cmd == "window":
        SliderWindow().run()
    elif cmd == "get":
        print(get_pct())
    elif cmd == "down":
        set_pct(get_pct() - STEP)
    elif cmd == "up":
        set_pct(get_pct() + STEP)
    elif cmd == "set":
        if len(argv) < 3:
            print("usage: aura-os-brightness set <pct>", file=sys.stderr)
            return 2
        set_pct(argv[2])
    else:
        print(f"aura-os-brightness: unknown '{cmd}'", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
