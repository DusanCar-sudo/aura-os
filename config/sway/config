# Aura OS — sway, purplerain theme (task 003).
# Flat, dark, no decoration: one monospace font, square corners, 1px
# borders, no blur/shadow/animation. Palette: themes/purplerain/.
# Muscle memory from 001:
#   Super+Return  terminal (foot)     Super+D  launcher (fuzzel)
#   Super+A       Aura prompt         Super+T  tabbed/split toggle
# Bindings live in config.d/.

set $mod Mod4
set $term aura-term
set $menu fuzzel --launch-prefix='aura-os-recent launch'

# Super+left-drag moves any window: drop a tiled one on another
# pane's edge to re-tile it there. Super+right-drag resizes.
floating_modifier $mod normal
tiling_drag enable
tiling_drag_threshold 9

# Aura OS look: monospace everywhere, 1px borders, square corners.
font pango:JetBrainsMono Nerd Font 11
# No window title bars: 1px border only. The focused title shows on
# hover at the top-left of the bar (waybar sway/window). Tabbed and
# stacked containers still show their titles (sway draws those).
default_border pixel 1
default_floating_border pixel 1
# No space between tiles: nothing shows through (wallpaper).
gaps inner 0
gaps outer 0

# Pane title drawn on the top border, left-aligned: ─ title ─
title_align left
titlebar_padding 4
for_window [title=".*"] title_format "─ %title ─"

# purplerain palette (themes/purplerain/palette): active purple, inactive dim.
client.focused          #8b7cf6 #0e0e14 #c8cad8 #8b7cf6
client.focused_inactive #2a2a3a #0e0e14 #5c5f77 #2a2a3a
client.unfocused        #2a2a3a #0e0e14 #5c5f77 #2a2a3a
client.background       #0e0e14

# No wallpaper: the theme background everywhere.
output * bg #0e0e14 solid_color

# Xwayland stays on but lazy (task 001b): it starts only when an X11
# app opens. Many of Dusan's apps need it — never disable it.
xwayland enable

# Autostart. Guards match the running process's exact command line —
# a loose pattern would also match this `sh -c` line itself and never
# start anything. sway re-runs exec lines on every config reload, so each
# one checks before starting. waybar runs both bars (top tabs + left
# sidebar) in one process — see config/waybar/config.jsonc. The
# watcher blocks on sway's event stream: event-driven, no polling.
# Tell systemd/D-Bus which session this is: the XDG portals (screen
# sharing, Aura computer use, file pickers) need it. Arch ships this in
# /etc/sway/config.d, which our config doesn't include.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland
exec pgrep -x waybar >/dev/null || waybar
exec pgrep -x mako >/dev/null || mako
exec pgrep -f '^bash /usr/local/bin/aura-os-status watch$' >/dev/null || aura-os-status watch
exec pgrep -f '^bash /usr/local/bin/aura-os-agents watch$' >/dev/null || aura-os-agents watch
exec pgrep -f '^bash /usr/local/bin/aura-os-recent watch$' >/dev/null || aura-os-recent watch
exec pgrep -f '^wl-paste --watch /usr/local/bin/aura-os-clip store$' >/dev/null || aura-os-clip watch

# Floating TUIs opened from the top bar (bt, wifi, vol, calendar).
for_window [app_id="aura-float"] floating enable, resize set 960 600, move position center

include ~/.config/sway/config.d/*

# Keyboard: US, Serbian Latin, Serbian Cyrillic — Alt+Shift cycles.
input type:keyboard {
    xkb_layout us,rs,rs
    xkb_variant ,latin,
    xkb_options grp:alt_shift_toggle
}
