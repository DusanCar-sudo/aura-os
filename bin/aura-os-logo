#!/usr/bin/env bash
# aura-os-logo — the splash screen's logo, drawn in block characters for the
# top of the sidebar: the striped "A", the sun behind it fading from the
# theme accent to its magenta, and "aura adOS" under it.
#
#   aura-os-logo          one waybar JSON reading (what the bar calls)
#   aura-os-logo plain    the logo in the terminal, true-colour
#   aura-os-logo header   the terminal header: mark, motto, copyright, repo
#   aura-os-logo banner   the banner atop each aura-term shell (the mark + who/what)
#   aura-os-logo mark     just the retro mark: "aura" and the Sinclair stripes
#
# Colours come from the active theme (~/.config/waybar/theme.css, written by
# aura-os-theme), so the logo follows a theme switch. So does the vertical
# tagline image in the sidebar: when the accent changes, this redraws
# assets/left-watermark.png in the new colours and reloads waybar once.
set -uo pipefail

theme="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/theme.css"
tok() { sed -n "s/^@define-color $1 \(#[0-9a-fA-F]\{6\}\);/\1/p" "$theme" 2>/dev/null | head -1; }
accent="$(tok accent)";   accent="${accent:-#00e5d0}"
magenta="$(tok red)";     magenta="${magenta:-#ff6ac7}"
bright="$(tok fg_bright)"; bright="${bright:-#d9fffc}"
muted="$(tok muted)";     muted="${muted:-#a7a9ac}"
dim="$(tok dim)";         dim="${dim:-#565b61}"

# mix <#a> <#b> <0..1> -> the colour between them
mix() {
    awk -v a="${1#\#}" -v b="${2#\#}" -v t="$3" 'function h(s){return index("0123456789abcdef",tolower(s))-1}
      function c(s,i){return h(substr(s,i,1))*16+h(substr(s,i+1,1))}
      BEGIN{printf "#%02x%02x%02x", c(a,1)+(c(b,1)-c(a,1))*t, c(a,3)+(c(b,3)-c(a,3))*t, c(a,5)+(c(b,5)-c(a,5))*t}'
}

# Each row: the stripes, the A, and the sun, on a fixed grid (5|14|7).
rows=(
  "|     |     ▄▄▄▄     | ▗▄▄▄▖ "
  "|     |    ▟████▙    |▟█████▙"
  "|     |   ▟██▘▝██▙   |███████"
  "| ━━━━|  ▟██▘  ▝██▙  |▜█████▛"
  "|━━━━ | ▟██▘━━━━▝██▙ | ▝▀▀▀▘ "
  "|━━━  |▟██▘      ▝██▙|       "
)
sun_rows=4

esc() { sed -e 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

render() { # render <pango|ansi>
    local mode=$1 i stripes letter sun col line
    for i in "${!rows[@]}"; do
        IFS='|' read -r _ stripes letter sun <<<"${rows[$i]}"
        col="$(mix "$accent" "$magenta" "$(awk -v i="$i" -v n="$sun_rows" 'BEGIN{t = (n>1? i/(n-1) : 0); printf "%.2f", (t>1? 1 : t)}')")"
        if [ "$mode" = pango ]; then
            line="<span color='$accent'>$(printf '%s' "$stripes" | esc)</span>"
            line+="<span color='$bright'>$(printf '%s' "$letter" | esc)</span>"
            line+="<span color='$col'>$(printf '%s' "$sun" | esc)</span>"
        else
            line="$(ansi "$accent")$stripes$(ansi "$bright")$letter$(ansi "$col")$sun"$'\e[0m'
        fi
        printf '%s\n' "$line"
    done
    if [ "$mode" = pango ]; then
        printf '%s\n' "<span color='$bright'><b>   aura ad</b></span><span color='$accent'><b>OS</b></span>"
        printf '%s' "<span color='$dim'>   agent-driven os</span>"
    else
        printf '%s\n' "$(ansi "$bright")   aura ad$(ansi "$accent")OS"$'\e[0m'
        printf '%s\n' "$(ansi "$dim")   agent-driven os"$'\e[0m'
    fi
}

ansi() { local h="${1#\#}"; printf '\e[1;38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

# ── the retro mark: "aura" and the four Sinclair stripes ────────────────────
# From the ∞K retro identity (~/Projects/aura-retro-design, brand/glyphs.py):
# 3-unit strokes on a 10-unit x-height, drawn one unit to a pixel and two
# pixel rows to a text row. "#" is a letter, drawn in the terminal's own
# foreground so it reads on light and dark themes. r y g c are the stripes,
# fixed like the rainbow on the case. They lean one pixel every two rows, so
# a cell never holds two colours.
mark=(
  "...#######..###....###..#######......#######.......rryyggcc"
  ".#########..###....###..#########..#########.......rryyggcc"
  ".#########..###....###..#########..#########......rryyggcc."
  "###....###..###....###..####......###....###......rryyggcc."
  "###....###..###....###..###.......###....###.....rryyggcc.."
  "###....###..###....###..###.......###....###.....rryyggcc.."
  "###....###..###....###..###.......###....###....rryyggcc..."
  ".#########...#########..###........#########....rryyggcc..."
  ".#########...#########..###........#########...rryyggcc...."
  "...#######.....#######..###..........#######...rryyggcc...."
)
declare -A stripe=([r]='228;49;43' [y]='248;185;30' [g]='47;174;78' [c]='26;166;224')
declare -A fg=(['#']=39)
for _c in r y g c; do fg[$_c]="38;2;${stripe[$_c]}"; done

# blocks <pixel rows...> -> BLOCKS, the rows as half-block text lines
blocks() {
    local -a px=("$@")
    local y x t b ch want cur line
    BLOCKS=()
    for ((y = 0; y + 1 < ${#px[@]}; y += 2)); do
        line='' cur=''
        for ((x = 0; x < ${#px[y]}; x++)); do
            t=${px[y]:x:1} b=${px[y+1]:x:1}
            if [ "$t" = . ] && [ "$b" = . ]; then ch=' ' want=${cur%%;48;*}
            elif [ "$t" = . ]; then ch='▄' want=${fg[$b]}
            elif [ "$b" = . ]; then ch='▀' want=${fg[$t]}
            elif [ "$t" = "$b" ]; then ch='█' want=${fg[$t]}
            else ch='▀' want="${fg[$t]};48;2;${stripe[$b]}"
            fi
            [ "$want" != "$cur" ] && line+=$'\e[0;'"${want}m" && cur=$want
            line+=$ch
        done
        BLOCKS+=("$line"$'\e[0m')
    done
}

# icon: the "a" and the stripes, for windows too narrow for the whole word
icon=()
for _r in "${mark[@]}"; do icon+=("${_r:0:10}${_r:45}"); done
unset _r _c

# lay_out <indent> <art width> <art array> <info array>: the info beside the
# art while each line fits the window, the rest underneath
lay_out() {
    local ind=$1 gap=3 cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
    local -n _art=$3 _info=$4
    local i k=0 n=${#_art[@]} col=$(($1 + $2 + 3)) under=$1
    while ((k < n && k < ${#_info[@]})); do
        vislen "${_info[k]}"; ((col + REPLY <= cols)) || break
        ((k++))
    done
    for ((i = 0; i < n; i++)); do
        if ((i < k)); then printf '%*s%s%*s%s\n' "$ind" '' "${_art[i]}" "$gap" '' "${_info[i]}"
        else printf '%*s%s\n' "$ind" '' "${_art[i]}"; fi
    done
    # past the art, keep to the text column if the rest all fit there
    if ((k == n)); then
        under=$col
        for ((i = k; i < ${#_info[@]}; i++)); do
            vislen "${_info[i]}"; ((col + REPLY <= cols)) || { under=$ind; break; }
        done
    fi
    for ((i = k; i < ${#_info[@]}; i++)); do printf '%*s%s\n' "$under" '' "${_info[i]}"; done
}
# vislen <text>: its width on screen, colour codes left out -> REPLY
vislen() {
    local s=$1 out=''
    while [[ $s == *$'\e['* ]]; do out+=${s%%$'\e['*}; s=${s#*$'\e['}; s=${s#*m}; done
    REPLY=$((${#out} + ${#s}))
}

# the mark as wide as the window allows: the word, the icon, or one line
show_mark() { # show_mark <indent> <info array>
    local cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
    if ((cols >= $1 + ${#mark[0]})); then
        blocks "${mark[@]}"; lay_out "$1" "${#mark[0]}" BLOCKS "$2"
    elif ((cols >= $1 + ${#icon[0]})); then
        blocks "${icon[@]}"; lay_out "$1" "${#icon[0]}" BLOCKS "$2"
    else
        local -n _lines=$2
        local line
        printf '%*s\e[1maura\e[0m \e[1;38;2;%sm/\e[38;2;%sm/\e[38;2;%sm/\e[38;2;%sm/\e[0m\n' \
            "$1" '' "${stripe[r]}" "${stripe[y]}" "${stripe[g]}" "${stripe[c]}"
        for line in "${_lines[@]:1}"; do printf '%*s%s\n' "$1" '' "$line"; done
    fi
}

# The header aura-term prints when a window opens: the mark on the left and,
# beside it, what any program shows in its about box. The copyright line
# matches LICENSE — Aura OS is proprietary, so it says so rather than MIT.
header() {
    local R=$'\e[0m' T=$'\e[1;39m' D; D="$(ansi "$dim")"
    local -a info=(
        "${T}aura ad$(ansi "$accent")OS$R  ${D}Agent-Driven OS$R"
        "$(ansi "$muted")Intelligence is in simplicity.$R"
        ""
        "${D}© 2026 Dusan Milosavljevic · All rights reserved$R"
        "${D}github.com/DusanCar-sudo/aura-os$R"
        "${D}minimal install · ask Aura to add only what you need$R"
        "${D}built by Dusan Milosavljevic · LeanPro IQ · Novi Sad / Da Nang$R"
    )
    printf '\n'
    show_mark 2 info
    printf '\n'
}

# The banner at the top of every new aura-term shell: the mark, who we are,
# what we do. Five rows, the text beside the mark when the window is wide
# enough. Turn it off with AURA_TERM_BANNER=0 in ~/.bashrc.
banner() {
    # the title in the terminal's own foreground, like the mark: the theme's
    # bright is near-white and vanishes on a light terminal theme
    local R=$'\e[0m' T=$'\e[1;39m' G M
    G="$(ansi "$accent")"; M="$(ansi "$muted")"
    local -a info=(
        "${T}aura ${G}OS$R"
        "${M}system: Aura OS · Arch · sway$R"
        "${M}user: ${USER:-$LOGNAME}  ·  aura code: ready$R"
        "${M}:a install <part>  or ask Aura what you need$R"
        "${M}built by Dusan Milosavljevic · LeanPro IQ · Novi Sad / Da Nang$R"
    )
    show_mark 1 info
    printf '\n'
}

# ── the vertical tagline image, in the theme's colours ──────────────────────
tagline() {
    local out="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/assets/left-watermark.png"
    local stamp="${XDG_CACHE_HOME:-$HOME/.cache}/aura-os-logo.stamp"
    local want="$accent $muted v1"
    [ "$(cat "$stamp" 2>/dev/null)" = "$want" ] && [ -f "$out" ] && return
    command -v magick >/dev/null || return
    local font=/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Bold.ttf
    [ -r "$font" ] || return
    local P=13 K=2 base adv x0=3 rx cx w t='Aura adOS   Intelligence is in simplicity'
    base="$(magick -background none -font "$font" -pointsize $P label:AAAAAAAAAA -format %w info:)" || return
    # monospace: every glyph advances the same, so positions are arithmetic.
    read -r adv rx cx w <<<"$(awk -v b="$base" -v k=$K -v x0=$x0 -v n=${#t} 'BEGIN{
        adv = b/10 + k
        printf "%.2f %.1f %.1f %d", adv, x0 + 2*adv, x0 + 38*adv - k, x0*2 + n*adv }')"
    # the underline runs from the r of "Aura" to the last c of "simplicity"
    mkdir -p "$(dirname "$out")" "$(dirname "$stamp")"
    magick -size "${w}x22" xc:none -font "$font" -pointsize $P -kerning $K -gravity northwest \
        -fill "$accent" -annotate "+${x0}+2" 'Aura adOS' \
        -fill "$muted" -annotate "+$(awk -v a="$adv" -v x=$x0 'BEGIN{printf "%d", x+12*a}')+2" 'Intelligence is in simplicity' \
        -fill "$accent" -draw "rectangle $rx,18 $cx,19" \
        -rotate -90 +repage "png:$out.new" && mv "$out.new" "$out" || return
    printf '%s' "$want" > "$stamp"
    # waybar only rereads a background image on reload
    pkill -USR2 -x -u "$(id -u)" waybar 2>/dev/null || true
}

case "${1:-}" in
    plain)  render ansi ;;
    header) header ;;
    banner) banner ;;
    mark)   blocks "${mark[@]}"; printf '%s\n' "${BLOCKS[@]}" ;;
    *)
        # Human-friendly when called from a shell; Waybar gets the JSON form.
        if [ -t 1 ]; then banner; exit 0; fi
        text="$(render pango | sed 's/"/\\"/g' | sed 's/$/\\n/' | tr -d '\n')"
        printf '{"text":"%s","tooltip":false,"class":"logo"}\n' "${text%\\n}"
        tagline
        ;;
esac
