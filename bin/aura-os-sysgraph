#!/usr/bin/env bash
# aura-os-sysgraph — the sidebar's system block: CPU, RAM, GPU, their
# temperatures, and what the machine is costing to run.
#
#   aura-os-sysgraph          one waybar JSON reading (what the bar calls)
#   aura-os-sysgraph plain    the same thing as plain text, for a terminal
#
# Everything comes from /proc and /sys — no daemon, no python, one shot per
# call. History for the sparklines lives in a small state file, so the graph
# survives between polls without anything staying resident.
set -uo pipefail

state="${XDG_RUNTIME_DIR:-/tmp}/aura-os-sysgraph"
mkdir -p "$state"
SPARK_N=10          # samples across the graph — always drawn 10 wide

# US residential average, EIA, 2025: 17.4 ¢/kWh. Override per machine:
#   echo 0.31 > ~/.config/aura-os/kwh-price      (euro-cents, pounds, whatever)
price_kwh=0.174
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/aura-os/kwh-price" ] &&
    price_kwh="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/aura-os/kwh-price")"

# ── sparkline ────────────────────────────────────────────────────────────────
# Push a sample, keep the last N, render as block glyphs. Values are 0-100.
spark() { # spark <name> <value> -> the line
    local f="$state/$1" v="${2:-0}"
    printf '%s\n' "$v" >> "$f"
    # Keep the file bounded without spawning tail on a huge file.
    if [ "$(wc -l < "$f")" -gt $SPARK_N ]; then
        tail -n $SPARK_N "$f" > "$f.new" && mv "$f.new" "$f"
    fi
    awk -v n=$SPARK_N '
      { a[NR] = $1 + 0 }
      END {
        split("▁ ▂ ▃ ▄ ▅ ▆ ▇ █", g, " ")
        start = (NR > n) ? NR - n + 1 : 1
        # Pad short history with blanks so the graph is always n wide.
        for (i = NR - start + 1; i < n; i++) printf " "
        for (i = start; i <= NR; i++) {
          v = a[i]; if (v < 0) v = 0; if (v > 100) v = 100
          k = int(v / 12.5) + 1; if (k > 8) k = 8
          printf "%s", g[k]
        }
      }' "$f"
}

# ── readings ─────────────────────────────────────────────────────────────────
# CPU busy % since the previous call: /proc/stat is cumulative, so it only
# means anything as a delta against the last sample.
cpu_pct() {
    local f="$state/cputime" idle total pidle ptotal d_idle d_total
    read -r _ u n s i io irq soft steal _ < /proc/stat
    idle=$(( i + io ))
    total=$(( u + n + s + i + io + irq + soft + steal ))
    if [ -r "$f" ]; then
        read -r pidle ptotal < "$f"
        d_idle=$(( idle - pidle )); d_total=$(( total - ptotal ))
        printf '%s %s\n' "$idle" "$total" > "$f"
        [ "$d_total" -gt 0 ] && echo $(( (100 * (d_total - d_idle)) / d_total )) && return
    fi
    printf '%s %s\n' "$idle" "$total" > "$f"
    echo 0
}

mem_read() { # -> "pct used_gib total_gib"
    awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2}
         END{ u=t-a; printf "%d %.1f %.1f", (t? u*100/t : 0), u/1048576, t/1048576 }' /proc/meminfo
}

gpu_pct() {
    local f
    for f in /sys/class/drm/card*/device/gpu_busy_percent; do
        [ -r "$f" ] && { cat "$f"; return; }
    done
    echo ""      # no integrated/discrete GPU that reports busy%
}

# hwmon names vary by machine; match the driver rather than a fixed index.
temp_of() { # temp_of <driver-name> [label]
    local want="$1" label="${2:-}" h n t
    for h in /sys/class/hwmon/hwmon*; do
        n="$(cat "$h/name" 2>/dev/null)" || continue
        [ "$n" = "$want" ] || continue
        if [ -n "$label" ]; then
            for t in "$h"/temp*_label; do
                [ -r "$t" ] && grep -qi "$label" "$t" &&
                    { awk '{printf "%d", $1/1000}' "${t%_label}_input"; return; }
            done
        fi
        for t in "$h"/temp1_input "$h"/temp2_input; do
            [ -r "$t" ] && { awk '{printf "%d", $1/1000}' "$t"; return; }
        done
    done
    echo ""
}

cpu_temp() { # AMD is k10temp, Intel coretemp; fall back to anything thermal
    local t; t="$(temp_of k10temp Tctl)"; [ -n "$t" ] || t="$(temp_of coretemp)"
    [ -n "$t" ] || t="$(temp_of acpitz)"
    echo "$t"
}
gpu_temp() { temp_of amdgpu; }

# power_w -> "<watts> <source>", or nothing.
# Real draw first: the battery reports it directly while discharging. On AC
# most laptops report nothing, so fall back to what the chip measures about
# itself — Intel RAPL, or the AMD APU's package power (PPT) that amdgpu
# exposes to every user. The chip is not the whole machine: screen, SSD,
# Wi-Fi and board add a few watts, estimated by platform-watts (default 5,
# ~/.config/aura-os/platform-watts to change) and marked with ≈.
platform_w=5
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/aura-os/platform-watts" ] &&
    platform_w="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/aura-os/platform-watts")"

power_w() {
    local p f uv cv h
    for f in /sys/class/power_supply/BAT*/power_now; do
        [ -r "$f" ] && p="$(cat "$f")" && [ "${p:-0}" -gt 0 ] &&
            { awk -v p="$p" 'BEGIN{printf "%.1f battery", p/1000000}'; return; }
    done
    # Some batteries only give current+voltage.
    for f in /sys/class/power_supply/BAT*; do
        [ -r "$f/current_now" ] && [ -r "$f/voltage_now" ] || continue
        cv="$(cat "$f/current_now")"; uv="$(cat "$f/voltage_now")"
        [ "${cv:-0}" -gt 0 ] &&
            { awk -v c="$cv" -v v="$uv" 'BEGIN{printf "%.1f battery", (c/1000000)*(v/1000000)}'; return; }
    done
    # Intel RAPL: package energy counter, joules since boot (often root-only).
    local e="/sys/class/powercap/intel-rapl:0/energy_uj" prev now
    if [ -r "$e" ]; then
        now="$(cat "$e")"
        if [ -r "$state/rapl" ]; then
            read -r prev pt < "$state/rapl"
            local dt=$(( $(date +%s) - pt ))
            printf '%s %s\n' "$now" "$(date +%s)" > "$state/rapl"
            [ "$dt" -gt 0 ] && [ "$now" -gt "$prev" ] &&
                { awk -v d=$(( now - prev )) -v t="$dt" -v x="$platform_w" \
                      'BEGIN{printf "%.1f chip", d/1000000/t + x}'; return; }
        else
            printf '%s %s\n' "$now" "$(date +%s)" > "$state/rapl"
        fi
    fi
    # AMD APU: package power in microwatts, CPU and GPU together.
    for h in /sys/class/hwmon/hwmon*; do
        [ "$(cat "$h/name" 2>/dev/null)" = amdgpu ] && [ -r "$h/power1_input" ] || continue
        p="$(cat "$h/power1_input")"
        [ "${p:-0}" -gt 0 ] &&
            { awk -v p="$p" -v x="$platform_w" 'BEGIN{printf "%.1f chip", p/1000000 + x}'; return; }
    done
    echo ""
}

# ── render ───────────────────────────────────────────────────────────────────
c_pct="$(cpu_pct)"
read -r m_pct m_used m_total <<<"$(mem_read)"
g_pct="$(gpu_pct)"
c_t="$(cpu_temp)"; g_t="$(gpu_temp)"
read -r watts wsrc <<<"$(power_w)"

c_spark="$(spark cpu "$c_pct")"
m_spark="$(spark mem "$m_pct")"
[ -n "$g_pct" ] && g_spark="$(spark gpu "$g_pct")"

if [ -n "$watts" ]; then
    # Cost if it ran at this draw all day / all month.
    read -r day month <<<"$(awk -v w="$watts" -v p="$price_kwh" \
        'BEGIN{ k=w/1000; printf "%.2f %.2f", k*24*p, k*24*30*p }')"
    approx=""; [ "$wsrc" = chip ] && approx="≈"
    power_line="$(printf 'pwr  %s%.0fW  $%s/day  $%s/mo' "$approx" "$watts" "$day" "$month")"
else
    power_line="power  not reported on AC"
fi

if [ "${1:-}" = plain ]; then
    printf 'cpu  %s  %3s%%  %s\n' "$c_spark" "$c_pct" "${c_t:+${c_t}°C}"
    printf 'ram  %s  %3s%%  %s/%sG\n' "$m_spark" "$m_pct" "$m_used" "$m_total"
    [ -n "$g_pct" ] && printf 'gpu  %s  %3s%%  %s\n' "$g_spark" "$g_pct" "${g_t:+${g_t}°C}"
    printf '%s\n' "$power_line"
    exit 0
fi

# waybar wants one JSON object; the text is Pango markup. Colours come from
# aura-os-theme via ~/.config/aura-os/colors.sed, the same way the other
# sidebar modules get theirs.
esc() { sed -e 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# Every row is the same shape, every field a fixed width, so nothing
# slides sideways as the numbers change. The font must be monospace
# (style.css) or the block glyphs change width.
row() { printf '%s %s %4s %s' "$1" "$2" "$3" "$4"; }
lines="$(row cpu "$c_spark" "${c_pct}%" "${c_t:+${c_t}°C}")
$(row ram "$m_spark" "${m_pct}%" "${m_used}/${m_total}G")"
[ -n "$g_pct" ] && lines="$lines
$(row gpu "$g_spark" "${g_pct}%" "${g_t:+${g_t}°C}")"
if [ -n "$watts" ]; then
    _p="$(printf '%s%.0fW $%s/d $%s/mo' "$approx" "$watts" "$day" "$month")"
else
    _p="not reported on AC"
fi
lines="$lines
pwr $_p"

text="$(printf '%s' "$lines" | esc | sed 's/$/\\n/' | tr -d '\n')"
text="${text%\\n}"

case "${wsrc:-}" in
    battery) how="measured by the battery" ;;
    chip)    how="chip power measured + ${platform_w}W estimated for screen, SSD, Wi-Fi" ;;
    *)       how="no power sensor" ;;
esac
tip="$how · cost if it ran like this 24h a day · electricity at \$$price_kwh/kWh (US average, EIA 2025)"
printf '{"text":"%s","tooltip":"%s","class":"sysgraph"}\n' "$text" "$tip"
