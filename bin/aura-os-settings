#!/usr/bin/env bash
# aura-os-settings — one text menu for every system setting (Super+,).
# Each entry opens the right tool in a floating aura-term (app_id
# aura-float). A dev OS: TUIs and plain files, no settings daemon.
#
#   aura-os-settings          pick from the menu
#   aura-os-settings <item>   open one directly (sound, wifi, ...)
set -euo pipefail

float() { exec aura-term --app-id=aura-float -e "$@"; }
hold()  { float sh -c "$1; printf '\n[any key]'; read -rsn1"; }

items="setup       language, keyboard, time, wifi, name  (tiles)
sound       volume, outputs, microphones   (list)
wifi        networks, password, saved      (list)
bluetooth   pair and connect headphones    (list)
mixer       per-stream routing             (wiremix)
netmanual   VPN, ethernet, advanced        (nmtui)
display     arrange screens, resolution, scale  (Super+P)
profile     performance / balanced / power-saver  (Super+Shift+P)
keyboard    layouts us / sr latin / sr cyrillic
theme       color combos: neon-night, cyan-grid, neon-day, and 8 more
wallpaper   solid theme color or an image
tab color   color of the current desk's tab
keys        every key binding              (read)
snapshots   system snapshots, roll back    (snapper)
updates     update all packages            (snapshot, then pacman -Syu)
sidebar     recent list: recent or frequent
ram         what uses memory now           (aura-os-bench)
llm         local model: is it up, how fast (test)
power       reboot, shut down, log out
about       Aura OS version and repo"

pick="${1:-}"
if [[ -z $pick ]]; then
    pick="$(printf '%s\n' "$items" | fuzzel --dmenu --prompt 'settings > ' --width 64 --lines 18)" || exit 0
    pick="${pick%% *}"
fi

repo="${AURA_OS_REPO:-$HOME/aura-os}"
case $pick in
    setup)     exec aura-os-setup ;;
    sound)     exec aura-os-audio ;;
    wifi)      exec aura-os-wifi ;;
    bluetooth) exec aura-os-bluetooth ;;
    mixer)     float wiremix ;;
    netmanual) float nmtui ;;
    display)   exec aura-os-display ;;
    profile)   exec aura-os-profile ;;
    keyboard)  hold "swaymsg -t get_inputs | jq -r '.[] | select(.type==\"keyboard\") | \"\\(.identifier): \\(.xkb_active_layout_name)\"' | sort -u; echo; echo 'switch: Alt+Shift   (layouts set in config/sway/config)'" ;;
    theme)     exec aura-os-theme pick ;;
    wallpaper) exec aura-os-wallpaper pick ;;
    tab)       exec aura-os-tab color-pick ;;
    keys)      float sh -c "grep -h '^bindsym' ~/.config/sway/config ~/.config/sway/config.d/*.conf | sed 's/^bindsym //; s/\\\$mod/Super/' | less" ;;
    snapshots) hold "sudo snapper -c root list | tail -n 15; echo; echo 'take one: aura-os-snapshot \"msg\"    roll back: aura-os-reset <n>'" ;;
    updates)   hold "aura-os-snapshot 'before system update' && sudo pacman -Syu" ;;
    sidebar)   m="$(printf 'recent\nfrequent\n' | fuzzel --dmenu --prompt "list mode ($(aura-os-recent mode)) > " --lines 2)" || exit 0
               aura-os-recent mode "$m" >/dev/null ;;
    ram)       hold "aura-os-bench" ;;
    llm)       hold "aura-os-llmtest" ;;
    power)     exec aura-os-power ;;
    about)     hold "echo 'Aura OS — a dev OS Aura built for herself'; git -C '$repo' log --oneline -5 2>/dev/null || true" ;;
    *) echo "aura-os-settings: unknown item '$pick'" >&2; exit 2 ;;
esac
